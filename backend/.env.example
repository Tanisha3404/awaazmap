# copy this file to .env and fill in your values; never commit .env.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/awaazmap
FIREBASE_PROJECT_ID=awaazmap
# Firebase UIDs of admins. Log in once, try the admin page: the 403 message shows your UID.
ADMIN_UIDS=
# Photo storage when deployed: cloudinary://API_KEY:API_SECRET@CLOUD_NAME (leave empty to store photos on local disk)
CLOUDINARY_URL=
# Only needed if the frontend is hosted on another domain
CLIENT_ORIGINS=
# Seed centre (defaults to Pune)
SEED_LAT=18.5204
SEED_LNG=73.8567
